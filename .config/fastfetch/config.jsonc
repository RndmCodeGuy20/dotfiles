{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user}@{host}"
        },
        "separator",
        {
            "type": "os",
            "key": "󰣇  OS"
        },
        {
            "type": "kernel",
            "key": "  Kernel"
        },
        {
            "type": "shell",
            "key": "  Shell"
        },
        {
            "type": "wm",
            "key": "  WM"
        },
        {
            "type": "theme",
            "key": "󰉦  Theme"
        },
        {
            "type": "font",
            "key": "  Font"
        },
        {
            "type": "terminal",
            "key": "  Terminal"
        },
        "separator",
        {
            "type": "cpu",
            "key": "  CPU"
        },
        {
            "type": "gpu",
            "key": "󰍛  GPU"
        },
        {
            "type": "memory",
            "key": "  RAM"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk"
        },
        "separator",
        {
            "type": "colors",
            "paddingLeft": 2
        }
    ]
}